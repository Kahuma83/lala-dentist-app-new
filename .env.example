# Supabase Environment Configuration
# Salin file ini menjadi .env.local untuk menjalankan aplikasi secara lokal.

# URL Project Supabase (contoh: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://gvkheuvywuskwumyrdip.supabase.co

# Anon Public API Key Supabase (didapat dari Project Settings -> API -> Project API keys -> anon public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imd2a2hldXZ5d3Vza3d1bXlyZGlwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTAyOTU2MDIsImV4cCI6MjEwNTg3MTYwMn0.T1xlig6EX-vaVh7RPgy5XKo9ySgru0sTfDbYz0pFlpY

# Opsional: hanya dibaca server.js untuk operasi admin yang memerlukan hak istimewa.
# Jangan pernah beri awalan VITE_ pada key ini atau gunakan di kode browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Backend chat Supabase yang terpisah; hanya dibaca server.js / Cloudflare Pages Functions.
# Terapkan migration di supabase/chat_migrations/ pada project chat ini, bukan project klinik.
CHAT_SUPABASE_URL=https://your-chat-project.supabase.co
CHAT_SUPABASE_SECRET_KEY=your_chat_project_server_secret

# Public Supabase Realtime connection for the doctor chat; values are included in the attendance portal build.
# The key must be the chat project's publishable/anon key, never its secret key.
VITE_CHAT_SUPABASE_URL=https://your-chat-project.supabase.co
VITE_CHAT_SUPABASE_ANON_KEY=your_chat_project_publishable_key
